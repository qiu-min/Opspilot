# Local infrastructure
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application connections
DATABASE_URL=postgresql://opspilot:opspilot_dev_password@localhost:5432/opspilot?schema=public
REDIS_URL=redis://localhost:6379

# Model Gateway: only server-side composition code should read these values.
# Put real credentials in the ignored local .env file; never commit them.
# The model gateway reads the variable named by config/model-providers.json.
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# Agent Service runtime
PORT=3000
HOST=127.0.0.1
OPS_PILOT_SHARED_STORAGE_ROOT=D:/AgentProjects/OpsPilot/backend/storage
# Leave blank to use the stable defaults under agent-service/.
SESSION_DIRECTORY=
MODEL_CONFIG_PATH=

# Backend-shared file storage root. Resource storagePath values are relative to this directory.
OPS_PILOT_SHARED_STORAGE_ROOT=

# The default model must be explicitly selected from model-providers.json.
DEFAULT_MODEL_PROVIDER=moonshot
DEFAULT_MODEL_ID=kimi-k3
