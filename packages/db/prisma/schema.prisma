generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATING
  RESOLVED
  CLOSED
}

model Incident {
  id              String           @id @default(uuid()) @db.Uuid
  status          IncidentStatus   @default(OPEN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  analysisRuns    AnalysisRun[]
  runEvents       RunEvent[]
  evidences       Evidence[]
  proposedActions ProposedAction[]
  alertReceipt    AlertReceipt?

  @@map("incidents")
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model AnalysisRun {
  id                 String              @id @default(uuid()) @db.Uuid
  incidentId         String              @db.Uuid
  incident           Incident            @relation(fields: [incidentId], references: [id])
  status             AnalysisRunStatus   @default(QUEUED)
  modelName          String?
  promptVersion      String?
  toolPermissions    Json?
  initiatedBy        String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  runEvents          RunEvent[]
  sourceEvidences    Evidence[]
  proposedActions    ProposedAction[]
  contextCheckpoints ContextCheckpoint[]
  alertReceipt       AlertReceipt?

  @@index([incidentId, createdAt])
  @@map("analysis_runs")
}

enum RunEventType {
  alert_received
  run_started
  model_response_delta
  model_response_completed
  tool_requested
  tool_started
  tool_progressed
  tool_completed
  action_proposed
  approval_requested
  approval_decided
  execution_started
  execution_completed
  run_completed
  run_failed
}

model AlertReceipt {
  id             String      @id @default(uuid()) @db.Uuid
  idempotencyKey String      @unique
  payload        Json
  incidentId     String      @unique @db.Uuid
  incident       Incident    @relation(fields: [incidentId], references: [id])
  runId          String      @unique @db.Uuid
  run            AnalysisRun @relation(fields: [runId], references: [id])
  createdAt      DateTime    @default(now())

  @@map("alert_receipts")
}

model RunEvent {
  id            String       @id @default(uuid()) @db.Uuid
  incidentId    String       @db.Uuid
  incident      Incident     @relation(fields: [incidentId], references: [id])
  runId         String       @db.Uuid
  run           AnalysisRun  @relation(fields: [runId], references: [id])
  parentEventId String?      @db.Uuid
  parentEvent   RunEvent?    @relation("RunEventParent", fields: [parentEventId], references: [id])
  childEvents   RunEvent[]   @relation("RunEventParent")
  type          RunEventType
  payload       Json
  schemaVersion Int          @default(1)
  createdAt     DateTime     @default(now())

  @@index([incidentId, createdAt])
  @@index([runId, createdAt])
  @@index([parentEventId])
  @@map("run_events")
}

enum EvidenceKind {
  LOGS
  METRICS
  RUNBOOK
  TOPOLOGY
}

model Evidence {
  id             String       @id @default(uuid()) @db.Uuid
  incidentId     String       @db.Uuid
  incident       Incident     @relation(fields: [incidentId], references: [id])
  sourceRunId    String?      @db.Uuid
  sourceRun      AnalysisRun? @relation(fields: [sourceRunId], references: [id])
  kind           EvidenceKind
  summary        String
  content        Json
  contentHash    String
  sourceUri      String?
  timeRangeStart DateTime?
  timeRangeEnd   DateTime?
  createdAt      DateTime     @default(now())

  @@index([incidentId, createdAt])
  @@index([sourceRunId])
  @@map("evidence")
}

enum ActionStatus {
  PROPOSED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  SUCCEEDED
  FAILED
}

model ProposedAction {
  id             String       @id @default(uuid()) @db.Uuid
  incidentId     String       @db.Uuid
  incident       Incident     @relation(fields: [incidentId], references: [id])
  runId          String       @db.Uuid
  run            AnalysisRun  @relation(fields: [runId], references: [id])
  status         ActionStatus @default(PROPOSED)
  actionType     String
  riskLevel      String
  parameters     Json
  rationale      String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approval       Approval?
  execution      Execution?

  @@index([incidentId, createdAt])
  @@index([runId, createdAt])
  @@index([status])
  @@map("proposed_actions")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model Approval {
  id        String           @id @default(uuid()) @db.Uuid
  actionId  String           @unique @db.Uuid
  action    ProposedAction   @relation(fields: [actionId], references: [id])
  decision  ApprovalDecision
  decidedBy String
  reason    String?
  decidedAt DateTime         @default(now())

  @@index([decidedAt])
  @@map("approvals")
}

enum ExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
}

model Execution {
  id             String          @id @default(uuid()) @db.Uuid
  actionId       String          @unique @db.Uuid
  action         ProposedAction  @relation(fields: [actionId], references: [id])
  status         ExecutionStatus @default(STARTED)
  executor       String
  idempotencyKey String          @unique
  result         Json?
  errorMessage   String?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?

  @@index([status, startedAt])
  @@map("executions")
}

model ContextCheckpoint {
  id             String      @id @default(uuid()) @db.Uuid
  runId          String      @db.Uuid
  run            AnalysisRun @relation(fields: [runId], references: [id])
  summary        String
  confirmedFacts Json
  hypotheses     Json
  evidenceIds    Json
  openQuestions  Json
  actionStates   Json
  createdAt      DateTime    @default(now())

  @@index([runId, createdAt])
  @@map("context_checkpoints")
}
